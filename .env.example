# ── Required for skeleton ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Email Agent (Chapter 2) ───────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Calendar Agent (Chapter 2) ───────────────────────────────────
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=

# ── Upstash Redis (Calendar HITL state) ──────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Telegram Agent (Chapter 2) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but recommended: any random string. Register the webhook with the same value as
# `secret_token`; requests without it are then rejected.
TELEGRAM_WEBHOOK_SECRET=

# ── Upstash QStash (Telegram relay — bypasses HF Spaces network block) ──
# Get from: https://console.upstash.com → QStash → tokens
QSTASH_TOKEN=

# ── Note ─────────────────────────────────────────────────────────
# Add your CV at:  assets/cv.pdf
# It will be attached by the Email agent when requested.
